import json

# Load the files
with open("jobs.json", "r") as f:
    jobs = json.load(f)

with open("job_data.json", "r") as f:
    job_data = json.load(f)

# Create a lookup dictionary from job_data.json
job_data_dict = {entry['type']: entry for entry in job_data}

# Merge the data
for job in jobs:
    mbti_type = job.get('type')
    if mbti_type in job_data_dict:
        job['good_qualities'] = job_data_dict[mbti_type].get('good_qualities', [])
        job['needs_improvement'] = job_data_dict[mbti_type].get('needs_improvement', [])

# Save the merged result
with open("merged_jobs.json", "w") as f:
    json.dump(jobs, f, indent=2)

print("Merged file saved as merged_jobs.json")
